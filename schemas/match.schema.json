      ],
      "enum": [
        "A",
        "B",
        null
      ]
    },
    "terminal_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "metrics": {
      "type": "object"
    },
    "bot_faults": {
      "type": [
        "integer",
        "null"
      ]
    },
    "fuel_suspensions": {
      "type": [
        "integer",
        "null"
      ]
    },
    "detail": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
